# Local, non-secret default so `cp .env.example .env` boots in mock mode with no edits.
WEBHOOK_SECRET=local-dev-shared-secret

DEVIN_MODE=mock
GITHUB_MODE=mock
USE_FIXTURES=0

# Required only when DEVIN_MODE=real
DEVIN_API_KEY=
DEVIN_ORG_ID=

# Required only when GITHUB_MODE=real
GITHUB_TOKEN=
GITHUB_REPO=neerajsa/superset
