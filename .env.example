WEBHOOK_SECRET=
DEVIN_API_KEY=
DEVIN_ORG_ID=
GITHUB_TOKEN=
GITHUB_REPO=neerajsa/superset

# Optional - seconds between automatic scans. Defaults to 86400 (daily) if unset.
# SCAN_INTERVAL_SECONDS=86400

# Optional - max seconds to poll a single Devin session before marking it timed_out
# and terminating it. Defaults to 7200 (2 hours) if unset.
# SESSION_TIMEOUT_SECONDS=7200
